# ============================================
# DATABASE (Neon PostgreSQL)
# ============================================
# Pooled connection — used by the app at runtime. Hostname contains "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/devstash?sslmode=require"

# Direct connection — used by the Prisma CLI for migrations and seeding.
# Same URL without "-pooler" in the hostname.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/devstash?sslmode=require"
